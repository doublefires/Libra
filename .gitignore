# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.log

# ---------- 生成产物（可随时重建，不入库） ----------
outputs/
data/
data_real/raw/
outputs_real/charts/
outputs_real/excel/
outputs_real/reports/daily_latest.md
outputs_real/reports/daily_latest.txt
exports/

# ---------- 本地配置（含邮箱凭据，不入库） ----------
mail_config.json
# 每日自动生成的早间基准（盘中对比用，9点cron每日覆写）
data_real/processed/morning_snapshot.json
data_real/processed/intraday/
# akshare 全量交易日历缓存（含节假日，供 daily.py 判休市/定决策日）
data_real/processed/trade_dates.csv
# 日报「已发送」状态（防重复推送）
outputs_real/reports/.last_sent.json
# 休市标记（由 daily.py 写、send_mail.py 读）
data_real/processed/market_closed.json
# 盘中发信门槛（daily.py 写、send_mail.py --intraday-gate 读）
data_real/processed/intraday_gate.json

# ---------- 缓存与临时 ----------
.cache/
*.bak.csv
# 历史临时脚本（点开头）
.*.py

# ---------- 数据策略 ----------
# data_real/processed/ 入库：评分序列、回测结果、纸面台账等研究产物（体积小、可复现）。
# data_real/raw/ 不入库：原始抓取数据可用 daily.py 随时重拉。
